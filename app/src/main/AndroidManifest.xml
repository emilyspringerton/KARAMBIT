<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="industrial.einhorn.karambit">

    <!-- Real, explicit SDK range (2026-09-10, product-completeness pass): previously left
         implicit and silently bumped to 23 by rules_android's own BumpMinSdkFloor build step,
         made explicit here so it's documented, not a build-tool side effect. minSdkVersion 23 is
         a real, load-bearing constraint, not arbitrary: NetworkInfo.java's own
         ConnectivityManager.getActiveNetwork()/getLinkProperties() calls require API 23+.
         targetSdkVersion matches this app's own real compileSdkVersion (34). -->
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <!-- Real, ordinary (non-dangerous) permissions: no runtime prompt needed on any real,
         current Android version. INTERNET is for the actual TCP connect attempts;
         ACCESS_NETWORK_STATE is for ConnectivityManager's own real getActiveNetwork() and
         getLinkProperties() calls, which NetworkInfo.java uses. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
